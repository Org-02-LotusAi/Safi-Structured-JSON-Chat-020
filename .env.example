# Copy to .env (gitignored) and fill in. Never commit real secrets.

# --- Pilot login (single user) ---
PILOT_USERNAME=pilot
# At least 12 characters.
PILOT_PASSWORD=change-me-please-12+
# At least 32 characters; used to sign session cookies.
SESSION_SECRET=change-me-to-a-random-string-of-32+-chars
SESSION_TTL_MIN=120

# --- Limits (checked before any NATS publish / OpenAI call) ---
# Max 10
USER_RATE_PER_MIN=10
# Persisted in DATA_DIR/usage.json so restarts do not reset it
PILOT_API_CALL_CAP=40
MAX_INPUT_CHARS=4000
MAX_TURNS=8
# Max 512
MAX_OUTPUT_TOKENS=512
BODY_LIMIT_BYTES=16384

# --- NATS ---
NATS_URL=nats://127.0.0.1:4222
# When NATS_USER is set, docker compose starts nats-server with --user/--pass and the worker, server and
# host-side tools (verify:live, drill:recovery) use the same values. Set NATS_PASS to a random value
# (e.g. `node -e "console.log(require('crypto').randomBytes(18).toString('hex'))"`). Leave both empty only
# for an unauthenticated, internal-only NATS (any local process could then bypass the server's caps).
NATS_USER=safi
NATS_PASS=change-me-to-a-random-value

# --- OpenAI (worker only) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Leave EMPTY for the real OpenAI API. Setting it (e.g. to a local mock) makes /api/status report
# upstream "custom", and npm run verify:live then refuses to run (BLOCKED). Set the same value for
# worker and server (compose does this, both read .env).
OPENAI_BASE_URL=
OPENAI_TIMEOUT_MS=25000

# --- HTTPS server ---
TLS_CERT_FILE=./infra/certs/dev.crt
TLS_KEY_FILE=./infra/certs/dev.key
HOST=0.0.0.0
PORT=8443
# Number of trusted reverse-proxy hops in front of the server (0 = none: X-Forwarded-For is ignored).
# Set 1 for the caddy compose profile or `npm run share:tunnel`. Only safe if clients cannot reach this
# port directly (compose publishes it on 127.0.0.1 only). TLS is independent of this setting.
TRUST_PROXY_HOPS=0
# Serve plain HTTP (no TLS_CERT_FILE/TLS_KEY_FILE). Only behind a TLS-terminating proxy; cookies stay Secure.
ALLOW_PLAIN_HTTP_BEHIND_PROXY=false
DATA_DIR=./data

# --- Optional: public TLS via the caddy compose profile ---
SAFI_DOMAIN=
